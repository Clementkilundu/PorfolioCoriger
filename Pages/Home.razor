@page "/"
@using MonPorfolio.Models
@using System.ComponentModel.DataAnnotations
@inject HttpClient Http

<PageTitle>Clément Kilundu – Développeur .NET, Blazor et MAUI</PageTitle>

<HeadContent>
    <meta name="description" content="Portfolio de Clément Kilundu, développeur Full-Stack .NET : applications Blazor, .NET MAUI et plateformes web." />
</HeadContent>

<div class="container my-5">

    <!-- HERO -->
    <section id="home" class="bg-white p-4 p-md-5 rounded shadow-sm mb-5">
        <div class="row align-items-center g-4">

            <!-- Photo : en premier sur mobile, à droite sur desktop -->
            <div class="col-md-5 order-md-2 text-center">
                <img src="clement_profile.png"
                     alt="Portrait de Clément Kilundu"
                     width="220" height="220"
                     class="rounded-circle border border-4 border-white shadow"
                     style="object-fit:cover;" />
            </div>

            <div class="col-md-7 order-md-1 text-center text-md-start">
                <h1 class="display-5 fw-bold">
                    Clément Kilundu
                </h1>
                <p class="fs-4 text-primary mb-3">
                    Développeur Full-Stack .NET
                </p>
                <p class="text-secondary">
                    Je conçois des applications web et mobiles avec C#, Blazor et .NET MAUI.
                </p>

                <div class="d-flex flex-wrap gap-2 justify-content-center justify-content-md-start mb-4">
                    @foreach (var skill in skills)
                    {
                        <span class="badge text-bg-light border fw-normal fs-6">@skill</span>
                    }
                </div>

                <div class="d-flex flex-wrap gap-3 align-items-center justify-content-center justify-content-md-start">
                    <a href="#projet" class="btn btn-primary btn-lg">Voir mes projets</a>
                    <a href="#contact" class="btn btn-outline-primary btn-lg">Me contacter</a>
                </div>

                <!-- Liens utiles pour un recruteur : GitHub, LinkedIn, e-mail, vidéos de démo -->
                <div class="mt-4 fs-3 d-flex gap-3 justify-content-center justify-content-md-start">
                    <a href="https://github.com/clementkilundu" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="text-dark"><i class="fab fa-github"></i></a>
                    <a href="https://www.linkedin.com/in/clement-kilundu-190a82271" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="text-primary"><i class="fab fa-linkedin"></i></a>
                    <a href="mailto:kilunduclemente@gmail.com" aria-label="Envoyer un e-mail" class="text-secondary"><i class="fas fa-envelope"></i></a>
                    <a href="https://wa.me/243995802729" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="text-success"><i class="fab fa-whatsapp"></i></a>
                    <a href="https://www.youtube.com/channel/UCiZ3IZvv9w9qg9C_2uc_2wQ" target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="text-danger"><i class="fab fa-youtube"></i></a>
                </div>
            </div>
        </div>
    </section>

    <!-- PROJETS -->
    <section id="projet" class="mb-5">
        <h2 class="fw-bold mb-4">Mes projets</h2>

        <div class="row g-4 justify-content-center">
            @foreach (var project in myProjects)
            {
                <div class="col-md-6 col-lg-4">
                    <!-- h-100 garantit que toutes les cartes de la ligne ont la même hauteur -->
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">

                            <!-- En-tête : Icône + Titre -->
                            <div class="d-flex align-items-center mb-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center text-white me-3 flex-shrink-0"
                                     style="width:48px;height:48px;background-color:@project.Color;">
                                    <i class="@project.Icon"></i>
                                </div>
                                <div>
                                    <!-- min-height pour s'assurer que les titres de 1 ou 2 lignes prennent la même place -->
                                    <h3 class="h5 card-title mb-0" style="min-height: 2.5rem;">@project.Title</h3>
                                    <small class="text-muted">@project.ShortDescription</small>
                                </div>
                            </div>

                            <!-- Description avec hauteur min et flex-grow pour caler le reste en bas -->
                            <p class="card-text text-secondary flex-grow-1" style="min-height: 5rem;">
                                @project.Description
                            </p>

                            <!-- Image du projet -->
                            @if (!string.IsNullOrWhiteSpace(project.ImageUrl))
                            {
                                <div class="img-project mb-3">
                                    <img src="/@project.ImageUrl"
                                         alt="@(project.ImageAlt ?? $"Capture d'écran de {project.Title}")"
                                         loading="lazy"
                                         class="img-fluid rounded border"
                                         style="width:100%;height:180px;object-fit:cover;" />
                                </div>
                            }

                            <!-- Technologies / Badges -->
                            <div class="d-flex flex-wrap gap-1 mb-3">
                                @foreach (var tech in project.Technologies)
                                {
                                    <span class="badge text-bg-primary">@tech</span>
                                }
                            </div>

                            <!-- Boutons d'action toujours alignés tout en bas grâce à mt-auto -->
                            <div class="mt-auto d-flex gap-2 pt-2 border-top">
                                @if (!string.IsNullOrWhiteSpace(project.DemoUrl))
                                {
                                    <a href="@project.DemoUrl" target="_blank" rel="noopener noreferrer" class="btn btn-success btn-sm">Voir la démo</a>
                                }
                                @if (!string.IsNullOrWhiteSpace(project.GithubUrl))
                                {
                                    <a href="@project.GithubUrl" target="_blank" rel="noopener noreferrer" class="btn btn-outline-dark btn-sm">Code source</a>
                                }
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="py-5">
        <h2 class="text-center mb-4">Contactez-moi</h2>

        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                @if (isSubmitted)
                {
                    <div class="alert alert-success shadow-sm" role="status">
                        <h4 class="alert-heading">Merci !</h4>
                        <p>Votre message a bien été envoyé. Je vous répondrai dès que possible.</p>
                        <button class="btn btn-outline-success btn-sm" @onclick="() => isSubmitted = false">Envoyer un autre message</button>
                    </div>
                }
                else
                {
                    <EditForm Model="@contactModel" OnValidSubmit="HandleSubmit" class="card p-4 shadow-sm">
                        <DataAnnotationsValidator />

                        @if (errorMessage is not null)
                        {
                            <div class="alert alert-danger" role="alert">@errorMessage</div>
                        }

                        <div class="mb-3">
                            <label for="contact-name" class="form-label">Nom</label>
                            <InputText id="contact-name" @bind-Value="contactModel.Name" class="form-control" placeholder="Votre nom" autocomplete="name" />
                            <ValidationMessage For="@(() => contactModel.Name)" class="text-danger" />
                        </div>

                        <div class="mb-3">
                            <label for="contact-email" class="form-label">E-mail</label>
                            <InputText id="contact-email" @bind-Value="contactModel.Email" class="form-control" placeholder="nom@exemple.com" autocomplete="email" />
                            <ValidationMessage For="@(() => contactModel.Email)" class="text-danger" />
                        </div>

                        <div class="mb-3">
                            <label for="contact-message" class="form-label">Message</label>
                            <InputTextArea id="contact-message" @bind-Value="contactModel.Message" class="form-control" rows="4" placeholder="Comment puis-je vous aider ?" />
                            <ValidationMessage For="@(() => contactModel.Message)" class="text-danger" />
                        </div>

                        <button type="submit" class="btn btn-primary w-100" disabled="@isSending">
                            @if (isSending)
                            {
                                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> <span>Envoi en cours…</span>
                            }
                            else
                            {
                                <span>Envoyer le message</span>
                            }
                        </button>
                    </EditForm>
                }
            </div>
        </div>
    </section>

</div>

@code {
    private readonly string[] skills =
    {
        "C# / .NET", "Blazor", ".NET MAUI", "SQL", "JavaScript", "HTML / CSS", "PHP / Laravel"
    };

    // TODO : remplacez ImageUrl par de vraies captures d'écran (ex. "images/microcom.png")
    // TODO : remplacez DemoUrl par un lien propre à chaque projet et ajoutez GithubUrl si possible
    private readonly List<Project> myProjects = new()
    {
        new Project
        {
            Title = "Bc Passeport Pro",
            ShortDescription = "Application MultiPlateforme",
            Description = "Application Multiplateforme fonctionnant en Android, IOS, Windows et Mac, qui permet d'éditer les photos passeports d'une manière professionnelle .",
            Technologies = new() { ".NET MAUI"},
            Icon = "fas fa-mobile-alt",
            Color = "#512bd4",
            ImageUrl = "passeport.png",
            DemoUrl = "https://www.youtube.com/@clementkilundu"
        },
        new Project
        {
            Title = "Plateforme E-Learning Pour CRM-UOB",
            ShortDescription = "Plateforme Web E-learning",
            Description = "Avec un collègue nous avons développer Une plateforme E-Learning dans le domaine de Santé et Médecine pour le Centre de Recherce Multi-sectoriel de l'Université Officielle de Bukavu (CRM-UOB)",
            Technologies = new() { ".Blazor" },
            Icon = "fas fa-book-open",
            Color = "#ff6b6b",
            ImageUrl = "e_learning.png",
            DemoUrl = "https://www.youtube.com/@clementkilundu"
        },
         new Project
        {
            Title = "Mon Porfolio",
            ShortDescription = "Site de Présentation",
            Description = "Mon site Web de présenation, celui-ci que vous consulter actuellement",
            Technologies = new() { ".Blazor" },
            Icon = "fas fa-world",
            Color = "rgb(107, 255, 149)",
            ImageUrl = "porfolio.png",
            DemoUrl = "https://salmon-beach-041698810.2.azurestaticapps.net/"
        }
    };

    private ContactRequest contactModel = new();
    private bool isSending;
    private bool isSubmitted;
    private string? errorMessage;

    public class ContactRequest
    {
        [Required(ErrorMessage = "Le nom est obligatoire.")]
        public string Name { get; set; } = "";

        [Required(ErrorMessage = "L'e-mail est obligatoire.")]
        [EmailAddress(ErrorMessage = "E-mail invalide.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Le message ne peut pas être vide.")]
        [MinLength(10, ErrorMessage = "Le message doit contenir au moins 10 caractères.")]
        public string Message { get; set; } = "";
    }

    private async Task HandleSubmit()
    {
        isSending = true;
        errorMessage = null;

        try
        {
            var response = await Http.PostAsJsonAsync("https://formspree.io/f/xdalwebd", contactModel);

            if (response.IsSuccessStatusCode)
            {
                isSubmitted = true;
                contactModel = new ContactRequest();
            }
            else
            {
                errorMessage = "Le message n'a pas pu être envoyé. Réessayez ou écrivez-moi directement par e-mail.";
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = "Connexion impossible. Vérifiez votre réseau et réessayez.";
        }
        finally
        {
            isSending = false;
        }
    }
}
