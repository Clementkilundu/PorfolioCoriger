@inherits LayoutComponentBase

<div class="d-flex flex-column min-vh-100 bg-light">

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold fs-5 text-dark" href="#home">Clément Kilundu</a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav"
                    aria-controls="navbarNav"
                    aria-expanded="false"
                    aria-label="Ouvrir le menu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <!-- data-bs-target=".navbar-collapse.show" referme le menu mobile après un clic -->
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    <li class="nav-item">
                        <a class="nav-link" href="#home" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">Accueil</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#projet" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">Projets</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#contact" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">Contact</a>
                    </li>
                    <li class="nav-item ms-lg-2 mt-2 mt-lg-0">
                        <a href="cv_clement.pdf" target="_blank" class="btn btn-primary btn-sm">
                            <i class="fas fa-download"></i>
                            Télécharger mon CV
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- CONTENU -->
    <main class="flex-grow-1 py-4">
        <div class="container">
            @Body
        </div>
    </main>

    <!-- FOOTER -->
    <footer class="bg-white text-center text-muted small py-3 border-top">
        &copy; @DateTime.Now.Year Clément Kilundu. Tous droits réservés.
    </footer>

</div>
